# Django configuration
SECRET_KEY=
DEBUG=True

# Database configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# Host ports exposed by docker-compose (change if 5432/8000 are already taken locally)
DB_HOST_PORT=5432
APP_PORT=8000

# API keys, addresses, private keys and other
INFURA_URL=
CONTRACT_ADDRESS=0x399c1448e0F34aB3722e3aFDd21301Ca6cFF4c4a
# CONTRACT_ABI is normally read from tokens/contract_abi.json; set this only to override it
# (e.g. when pointing CONTRACT_ADDRESS at a different contract).
# CONTRACT_ABI=
PUBLIC_ADDRESS=
PRIVATE_KEY=

# Sepolia by default; override only if minting on a different network.
# CHAIN_ID=11155111
# GAS_LIMIT=300000
